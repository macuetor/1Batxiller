site_name: Informàtica I – IES Joan Fuster de Bellreguard
site_url: https://<el-teu-usuari>.github.io/<nom-del-repositori>/
site_description: Materials del curs d'Informàtica I (1r Batxillerat)
site_author: Manuel – Departament d'Informàtica

theme:
  name: material
  language: ca
  palette:
    primary: blue
    accent: indigo
  features:
    - navigation.tabs
    - navigation.sections
    - navigation.expand
    - content.code.copy
    - content.code.annotate

nav:
  - Portada: portada.md
  - Índex general: index.md
  - Unitats:
      - UD01 – Ciutadania digital: unidades/UD01_ciutadania_digital.md
      - UD02 – Pensament computacional: unidades/UD02_pensament_computacional.md
      - UD03 – Programació bàsica: unidades/UD03_programacio_basica.md
      - UD04 – Funcions i modularitat: unidades/UD04_funcions_i_modularitat.md
      - UD05 – Sistemes informàtics: unidades/UD05_sistemes_informatics.md
      - UD06 – Xarxes informàtiques: unidades/UD06_xarxes_basics.md
      - UD07 – Sistemes d’informació en xarxa: unidades/UD07_sistemes_informacio_en_xarxa.md
      - UD08 – Projecte integrador: unidades/UD08_projecte_integrador.md

markdown_extensions:
  - admonition
  - codehilite
  - toc:
      permalink: true
  - footnotes
  - tables
  - attr_list
  - md_in_html
